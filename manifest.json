{
  "manifest_version": 3,
  "name": "Internet Archive PDF Downloader",
  "version": "3.4.0",
  "description": "Production-grade book downloader & PDF exporter for Internet Archive, Open Library, and BookReader sites.",
  "author": "Abu Saleh (https://abusaleh.pro.bd/)",
  "homepage_url": "https://abusaleh.pro.bd/",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internet Archive PDF Downloader",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": [
        "pdf_writer.js",
        "deobfuscator.js",
        "detector.js",
        "streamer.js",
        "content.js"
      ],
      "css": ["content.css"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
